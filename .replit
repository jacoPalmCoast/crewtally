modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.development]
APP_ENV = "development"
PUBLIC_BASE_URL = "https://d545b864-b445-49e9-8fb5-949b581421df-00-nan59254efun.janeway.replit.dev/api"

[userenv.shared]
EMAIL_FROM = "CrewTally <codes@crewtallyapp.com>"
EMAIL_PROVIDER = "resend"

[nix]
channel = "stable-25_05"
packages = ["glib", "nspr", "nss"]
